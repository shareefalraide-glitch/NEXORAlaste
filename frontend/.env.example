# Copy to .env.local to enable real API login instead of the isolated demo.
# The API client sends relative /api/v1 requests; Vite proxies them server-side.
VITE_NEXORA_AUTH_MODE=demo
# Keep this server-side variable non-VITE so it is never exposed as browser config.
NEXORA_API_PROXY_TARGET=http://127.0.0.1:8080
